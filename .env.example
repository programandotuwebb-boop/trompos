# Sistema de reservas (Google Calendar) — ver instrucciones de configuración
# en la conversación/README. Ninguna de estas variables tiene valores reales
# acá; cada quien las carga en su propio .env.local (nunca se commitea).

# ID del calendario a usar (para un Gmail personal, es esa misma dirección).
GOOGLE_CALENDAR_ID=

# Email de la Service Account de Google Cloud (termina en .iam.gserviceaccount.com).
GOOGLE_CLIENT_EMAIL=

# Clave privada de la Service Account (bloque completo, incluyendo
# -----BEGIN PRIVATE KEY----- y -----END PRIVATE KEY-----).
GOOGLE_PRIVATE_KEY=
