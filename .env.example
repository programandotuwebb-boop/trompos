# Agenda y precios: PostgreSQL es obligatorio. Ninguna variable es NEXT_PUBLIC_.
DATABASE_URL=
# Origen exacto de la web, sin / final, para login y acciones privadas.
APP_ORIGIN=http://localhost:3000

# Emails opcionales; no condicionan la confirmación del turno.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Solo bootstrap/restablecimiento local. Quitar después de crear las cuentas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=OWNER
ADMIN_PROFESSIONAL_ID=

# Pruebas: base separada cuyo nombre termine en _test.
TEST_DATABASE_URL=

# OPCIONAL: solo importación histórica manual, nunca utilizadas por la web.
# No hacen falta para reservar, administrar horarios ni ejecutar la aplicación.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
